<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:StarfieldWeaponIconFileBuilder.ViewModels"
             xmlns:dd="clr-namespace:Avalonia.Input;assembly=Avalonia.Base" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StarfieldWeaponIconFileBuilder.SvgDropZone" x:DataType="vm:MainWindowViewModel">
  <Grid>

        <Rectangle x:Name="DropZoneBorder" StrokeDashArray="9,4" Stroke="{Binding BorderStroke, Mode=TwoWay}" StrokeThickness="2" RadiusX="10" RadiusY="10" Fill="Transparent"/>

        <Border x:Name="DropZone" BorderBrush="Gray" BorderThickness="0" CornerRadius="10" Background="{Binding BackgroundColor, Mode=TwoWay}" dd:DragDrop.AllowDrop="True"
                dd:DragDrop.Drop="OnDrop" dd:DragDrop.DragOver="OnDragOver" dd:DragDrop.DragEnter="OnDragEnter" dd:DragDrop.DragLeave="OnDragLeave">

            <Grid Background="Transparent">

                <Image Source="{Binding SvgPreview}" Stretch="Uniform" Margin="5"/>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ConstellationWhite}" IsVisible="{Binding ShowPlaceholder}" TextAlignment="Center" TextWrapping="Wrap">
                    Drag &amp; Drop Weapon Icon SVG file here
                    <LineBreak/>
                    or use the "Browse" button below
                </TextBlock>

            </Grid>

        </Border>

    </Grid>

</UserControl>
